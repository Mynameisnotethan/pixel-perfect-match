# Copy to .env.lockbox on the server (never commit it). See docs/HOSTINGER_DEPLOY.md.
LOCKBOX_DOMAIN=mail.example.com
LOCKBOX_PUBLIC_URL=https://mail.example.com
# Lockbox login (Caddy). Make the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Write every $ in the hash as $$
LOCKBOX_LOGIN_USER=me
LOCKBOX_LOGIN_HASH=
LOCKBOX_TOKEN_KEY=            # openssl rand -base64 32
LOCKBOX_GOOGLE_CLIENT_ID=
LOCKBOX_GOOGLE_CLIENT_SECRET=
LOCKBOX_MS_CLIENT_ID=
LOCKBOX_MS_CLIENT_SECRET=
