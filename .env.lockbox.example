# Only this one value is needed before deployment in Hostinger Docker Manager.
# A bare hostname: no https:// and no trailing slash. Hostinger's own VPS hostname works.
LOCKBOX_DOMAIN=mail.example.com

# The administrator account is created in the browser after deployment: open the site, copy the
# one-time setup code from the mail container's logs, then choose a username and password there.
# Nothing else has to be filled in beforehand.

# Add Google and Outlook credentials after deployment in Add mailbox -> Setup.
# Optional advanced override: LOCKBOX_TOKEN_KEY (auto-generated on the data volume if empty).

# Upgrading from the older setup? If LOCKBOX_LOGIN_PASSWORD is still set, the mail container keeps
# that username (LOCKBOX_LOGIN_USER, default "owner") and password as the administrator account on
# first start, so existing mailboxes stay where they are. Delete the variable once you are in.

# Optional: run images built from your own repository instead of the upstream ones.
# LOCKBOX_IMAGE_ORG=your-github-username
# LOCKBOX_IMAGE_TAG=latest
