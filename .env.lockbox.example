# Paste these into Hostinger Docker Manager's Environment panel (or save as .env on the server).
LOCKBOX_DOMAIN=mail.example.com
LOCKBOX_LOGIN_USER=admin
LOCKBOX_LOGIN_PASSWORD=choose-a-long-password
# Optional — the in-app Setup wizard covers these. Values here win over Setup.
# LOCKBOX_MS_DEVICE_CLIENT_ID=   # public Outlook "sign-in by code" app ID
# LOCKBOX_TOKEN_KEY=             # auto-generated on the data volume if empty
# LOCKBOX_GOOGLE_CLIENT_ID=
# LOCKBOX_GOOGLE_CLIENT_SECRET=
