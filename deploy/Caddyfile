# Caddy gets the HTTPS certificate automatically and passes requests through.
# Signing in happens inside the Lockbox app: the mail server checks its own session cookie, so no
# password or password hash ever lives in this file.
{$LOCKBOX_DOMAIN} {
	encode gzip
	@mail path /oauth/* /api/* /.well-known/oauth-* /.well-known/openid-configuration
	handle @mail {
		reverse_proxy mail:3000
	}
	handle {
		reverse_proxy web:3000
	}
}
