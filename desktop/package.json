{
  "name": "lockbox-desktop",
  "productName": "Lockbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "renderer": "cd .. && npx vite build --config desktop/vite.renderer.config.mjs",
    "start": "npm run shared && LOCKBOX_ALLOW_PARTIAL=1 node scripts/write-config.mjs && npm run renderer && electron .",
    "config": "node scripts/write-config.mjs",
    "dist:win": "npm run shared && node scripts/write-config.mjs && npm run renderer && electron-builder --win nsis",
    "dist:mac": "npm run shared && node scripts/write-config.mjs && npm run renderer && electron-builder --mac dmg",
    "dist:linux": "npm run shared && node scripts/write-config.mjs && npm run renderer && electron-builder --linux AppImage",
    "shared": "node -e \"require('fs').cpSync('../connectors','connectors',{recursive:true})\""
  },
  "dependencies": {
    "imapflow": "^2.11.0",
    "keytar": "^7.9.0",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.lockbox.desktop",
    "productName": "Lockbox",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.mjs",
      "secure-store.mjs",
      "preload.cjs",
      "renderer-dist/**",
      "release-config.json",
      "connectors/**"
    ],
    "extraMetadata": {
      "main": "main.mjs"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
